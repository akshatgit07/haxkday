# Reasoning
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p1-70b-instruct

# Voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Static secret configured on the ElevenLabs agent's server-tool webhook header
ELEVENLABS_WEBHOOK_SECRET=
# Printed by scripts/provision_elevenlabs_agent.py after it creates the agent
ELEVENLABS_AGENT_ID=

# Sandbox
DAYTONA_API_KEY=

# Observability
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT=morgan-ai

# Memory (short-term turn log + long-term semantic recall)
# Leave MONGODB_URI unset to run stateless — nothing else here is required.
MONGODB_URI=
MONGODB_DB=morgan_ai
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-finance-2
EMBEDDING_DIMENSIONS=1024
MEMORY_TURN_WINDOW=8
MEMORY_RECALL_K=4
MEMORY_MIN_SCORE=0.55
MEMORY_TTL_SECONDS=86400

# Market / filing data
SEC_EDGAR_USER_AGENT=
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
FMP_API_KEY=

# Web
# Comma-separated list of origins allowed to call this API (the deployed frontend's URL, in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000
